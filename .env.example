# Verificación de cédulas con la API pública de Hacienda (api.hacienda.go.cr).
# true: consulta la cédula al crear un ticket. false: no consulta nada (útil sin internet).
HACIENDA_CHECK=true

# true: rechaza (400) las cédulas que Hacienda no encuentra.
# false: las acepta igual. Si Hacienda no responde, siempre se acepta.
HACIENDA_STRICT=false
