# Copia este archivo como .env y completa los valores. Nunca subas .env a GitHub.

# Correo de soporte (Microsoft 365 con Microsoft Graph, permisos delegados).
# true: el Agente virtual revisa la carpeta y envía respuestas por correo. false: no lee ni envía nada (solo lo anota en el log).
EMAIL_ENABLED=false
# Id. de directorio (inquilino) y de aplicación (cliente) del registro de la app en Microsoft Entra ID.
MS_TENANT_ID=pon_aqui_el_id_de_directorio
MS_CLIENT_ID=pon_aqui_el_id_de_aplicacion
# Buzón que lee y desde el que responde el Agente virtual (la cuenta con la que se inicia sesión).
SUPPORT_MAILBOX=soporte@ejemplo.com
# Carpeta del buzón donde llegan los correos de soporte.
MAIL_FOLDER=Ticketera
# Cada cuántos segundos se revisa la carpeta en busca de correos no leídos.
EMAIL_POLL_SECONDS=60

# Inicio de sesión del personal (técnicos, coordinadores y administradores) con su cuenta Microsoft.
# Los clientes siguen entrando con correo y contraseña.
# true: el personal solo entra con Microsoft (el administrador además tiene "Acceso de emergencia").
# false: todo funciona con contraseña como antes.
MS_LOGIN_ENABLED=false
# Mismo registro de aplicación que el buzón (mismos id. de directorio y de aplicación).
MS_LOGIN_TENANT_ID=
MS_LOGIN_CLIENT_ID=
# Secreto de cliente propio del inicio de sesión (Certificados y secretos). Vence: anote la fecha y renuévelo antes.
MS_LOGIN_CLIENT_SECRET=
# Debe registrarse igual en Azure (Autenticación > Web). Con HTTPS cambia a https://.../auth/microsoft/callback
MS_LOGIN_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# Dominios de la empresa, separados por coma (ejemplo: data.cr). Incluye sus subdominios.
# Esos correos no pueden registrarse como cliente ni pasar a ser el correo de un cliente.
# Vacío: no bloquea nada.
INTERNAL_DOMAINS=

# Verificación de cédulas con la API pública de Hacienda (api.hacienda.go.cr).
# true: consulta la cédula al crear un ticket. false: no consulta nada (útil sin internet).
HACIENDA_CHECK=true

# true: rechaza (400) las cédulas que Hacienda no encuentra.
# false: las acepta igual. Si Hacienda no responde, siempre se acepta.
HACIENDA_STRICT=false

# Asistente de la página con un modelo local (Ollama, servicio "ollama" de docker-compose.yml).
# Antes de encenderlo descarga el modelo: docker compose exec ollama ollama pull qwen3:1.7b
# true: muestra respuestas del asistente. false: responde "no está disponible".
CHATBOT_ENABLED=false
# Dirección de Ollama dentro de la red de Docker Compose.
LLM_BASE_URL=http://ollama:11434
# Modelo que usa el asistente (debe estar descargado en Ollama).
LLM_MODEL=qwen3:1.7b

# Análisis de los correos con IA (mismo LLM_BASE_URL y LLM_MODEL del asistente).
# true: cada ticket creado desde un correo recibe nivel, categoría sugerida, resumen y tiempo meta.
# Solo se muestra: no cambia prioridad, estado ni asignación, ni responde correos.
# Corre dentro de la revisión del buzón, así que también necesita EMAIL_ENABLED=true.
AI_ANALYSIS_ENABLED=false

# Horario de oficina para calcular los tiempos meta.
# Días hábiles (1 = lunes ... 7 = domingo): un rango "1-5" o una lista "1,2,3,4,5".
OFFICE_DAYS=1-5
OFFICE_START=08:00
OFFICE_END=17:00
OFFICE_TZ=America/Costa_Rica
# Feriados que no cuentan, en formato AAAA-MM-DD separados por coma (ejemplo: 2026-12-25,2027-01-01).
OFFICE_HOLIDAYS=

# Resumen diario por correo para coordinadores y administradores activos.
# Se envía una vez por día hábil (según OFFICE_DAYS y OFFICE_HOLIDAYS) a partir de la hora indicada
# (0 a 23, hora local de OFFICE_TZ). Necesita EMAIL_ENABLED=true.
DAILY_SUMMARY_ENABLED=false
DAILY_SUMMARY_HOUR=8

# Alertas por correo (una sola vez por ticket o borrador y tipo). Necesita EMAIL_ENABLED=true.
# - Crítico (nivel 4): a coordinadores y administradores activos.
# - Por vencer: cuando pasó ALERT_WARN_PERCENT % del tiempo meta en horas hábiles; al técnico asignado
#   (sin asignado, a coordinadores y administradores).
# - Vencido: a coordinadores, administradores y al técnico asignado.
# ALERTS_CHECK_SECONDS: cada cuántos segundos se revisa.
ALERTS_ENABLED=false
ALERT_WARN_PERCENT=75
ALERTS_CHECK_SECONDS=120

# Asignación automática de tickets nuevos (no necesita el correo). Después del análisis de la IA,
# al técnico activo, Disponible y en turno con menos carga. AUTO_ASSIGN_LOAD_MODE:
# levels (suma de niveles de sus tickets abiertos; sin nivel cuenta 2) o count (cantidad).
# AUTO_ASSIGN_CHECK_SECONDS: cada cuántos segundos se reintentan los que quedaron sin candidato.
AUTO_ASSIGN_ENABLED=false
AUTO_ASSIGN_LOAD_MODE=levels
AUTO_ASSIGN_CHECK_SECONDS=60

# Vencimiento de sesión: se cierra tras SESSION_IDLE_MINUTES sin uso o SESSION_MAX_HOURS desde que se abrió.
SESSION_IDLE_MINUTES=240
SESSION_MAX_HOURS=12

# Carpeta donde se guardan los adjuntos de los comentarios (con nombre aleatorio).
# Debe quedar dentro de data/ para que el volumen de docker-compose.yml la conserve.
ATTACHMENTS_DIR=data/attachments

# Agrupación automática de tickets similares (usa el mismo Ollama: LLM_BASE_URL y LLM_MODEL).
# true: al crear un ticket o un borrador se buscan tickets abiertos parecidos.
#   - Mismo cliente (últimos 7 días): el nuevo se fusiona en el abierto.
#   - Otros clientes (últimas 48 h): se ligan al más antiguo; con GROUPING_INCIDENT_MIN o más
#     en GROUPING_INCIDENT_HOURS horas se marca "Posible incidente".
# Siempre se puede deshacer con "Separar". Antes de encenderlo descarga el modelo:
#   docker compose exec ollama ollama pull qwen3-embedding:0.6b
GROUPING_ENABLED=false
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Similitud mínima (0 a 1) para preguntarle a la IA si es el mismo problema. Altas: mejor no agrupar que agrupar mal.
GROUPING_MERGE_THRESHOLD=0.80
GROUPING_INCIDENT_THRESHOLD=0.85
GROUPING_INCIDENT_MIN=3
GROUPING_INCIDENT_HOURS=2
# Tiempo máximo de la búsqueda por ticket (segundos). Si se pasa, el ticket se crea normal.
GROUPING_TIMEOUT_SECONDS=15
