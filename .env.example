# Copia este archivo como .env y completa los valores. Nunca subas .env a GitHub.

# Correo de soporte (Microsoft 365 con Microsoft Graph, permisos delegados).
# true: el Agente virtual revisa la carpeta y envía respuestas por correo. false: no lee ni envía nada (solo lo anota en el log).
EMAIL_ENABLED=false
# Id. de directorio (inquilino) y de aplicación (cliente) del registro de la app en Microsoft Entra ID.
MS_TENANT_ID=pon_aqui_el_id_de_directorio
MS_CLIENT_ID=pon_aqui_el_id_de_aplicacion
# Buzón que lee y desde el que responde el Agente virtual (la cuenta con la que se inicia sesión).
SUPPORT_MAILBOX=soporte@ejemplo.com
# Carpeta del buzón donde llegan los correos de soporte.
MAIL_FOLDER=Ticketera
# Cada cuántos segundos se revisa la carpeta en busca de correos no leídos.
EMAIL_POLL_SECONDS=60

# Verificación de cédulas con la API pública de Hacienda (api.hacienda.go.cr).
# true: consulta la cédula al crear un ticket. false: no consulta nada (útil sin internet).
HACIENDA_CHECK=true

# true: rechaza (400) las cédulas que Hacienda no encuentra.
# false: las acepta igual. Si Hacienda no responde, siempre se acepta.
HACIENDA_STRICT=false

# Asistente de la página con un modelo local (Ollama, servicio "ollama" de docker-compose.yml).
# Antes de encenderlo descarga el modelo: docker compose exec ollama ollama pull qwen3:1.7b
# true: muestra respuestas del asistente. false: responde "no está disponible".
CHATBOT_ENABLED=false
# Dirección de Ollama dentro de la red de Docker Compose.
LLM_BASE_URL=http://ollama:11434
# Modelo que usa el asistente (debe estar descargado en Ollama).
LLM_MODEL=qwen3:1.7b
